{
	"name": "hypejunction/http-parser",
	"description": "A tool for scraping URL resources (oEmbed, OpenGraph, Twitter cards, JSON-LD)",
	"homepage": "https://github.com/hypeJunction/http-parser",
	"keywords": [
		"scraper", "open graph", "oembed", "twitter tags", "card", "json-ld", "link preview"
	],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Ismayil Khayredinov",
			"email": "info@hypejunction.com"
		}
	],
	"require": {
		"php": "^8.1",
		"ext-dom": "*",
		"ext-json": "*",
		"ext-libxml": "*",
		"ext-mbstring": "*",
		"ext-simplexml": "*",
		"guzzlehttp/guzzle": "^7.5",
		"guzzlehttp/psr7": "^2.4",
		"psr/http-message": "^1.1 || ^2.0",
		"psr/log": "^1.1 || ^2.0 || ^3.0"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.0",
		"phpunit/phpunit": "^10.5 || ^11.0"
	},
	"autoload": {
		"psr-4": {
			"hypeJunction\\": "src/hypeJunction/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"hypeJunction\\": "tests/hypeJunction/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"analyse": "phpstan analyse"
	},
	"config": {
		"sort-packages": true
	}
}
